# Build context: the repository root. See juiced/rewrite/container/build.sh.
ARG RUST_IMAGE=docker.io/library/rust:1.97-slim-trixie
ARG BUN_IMAGE=docker.io/oven/bun:1.4.4
ARG RUNTIME_IMAGE=docker.io/library/debian:trixie-slim

FROM ${RUST_IMAGE} AS service
WORKDIR /src/juiced/rewrite
# The service embeds the native model registry and the runtime catalog at compile time.
COPY src/cpp/resources/server_models.json src/cpp/resources/architecture_defaults.json \
    /src/src/cpp/resources/
COPY juiced/rewrite/catalog-design/inventory.json catalog-design/
COPY juiced/rewrite/Cargo.toml juiced/rewrite/Cargo.lock ./
COPY juiced/rewrite/service/ service/
COPY juiced/rewrite/rust-tests/ rust-tests/
RUN --mount=type=cache,id=juiced-rewrite-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=juiced-rewrite-cargo-target,target=/src/juiced/rewrite/target \
    cargo build --release --locked -p juiced-service --bin lemond --bin lemonade \
    && install -D -m 0755 target/release/lemond /out/lemond \
    && install -D -m 0755 target/release/lemonade /out/lemonade

FROM ${BUN_IMAGE} AS ui
WORKDIR /src/juiced/rewrite/ui
COPY juiced/rewrite/ui/package.json juiced/rewrite/ui/bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts
COPY juiced/ui/public/ /src/juiced/ui/public/
COPY juiced/ui/LICENSE.t3code juiced/ui/T3-SOURCES.json /src/juiced/ui/
COPY juiced/rewrite/ui/ ./
RUN bun run build

# FUTO publishes no transcribe.cpp builds. This builds the same pinned source and adapter
# as the native image, on the runtime's Debian release so glibc and libstdc++ match.
FROM ${RUNTIME_IMAGE} AS futo
ARG DEBIAN_FRONTEND=noninteractive
ARG FUTO_REVISION=26d75933c16b2cec228e34c69e92a6c3c154b97c
ARG FUTO_ARCHIVE_SHA256=2406099892f60fa4fcdf30cfd4f86858cd66b054c96827af76670bc9a20d4cab
ARG FUTO_ARCHIVE_BYTES=47097391
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake curl jq ninja-build \
    && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 3 -o /tmp/transcribe.tar.gz \
        "https://gitlab.futo.org/api/v4/projects/keyboard%2Ftranscribe.cpp/repository/archive.tar.gz?sha=$FUTO_REVISION" \
    && echo "$FUTO_ARCHIVE_SHA256  /tmp/transcribe.tar.gz" | sha256sum -c - \
    && mkdir /native && tar -xzf /tmp/transcribe.tar.gz --strip-components=1 -C /native \
    && rm /tmp/transcribe.tar.gz
RUN cmake -S /native -B /native/build -G Ninja -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF \
        -DTRANSCRIBE_BUILD_TESTS=OFF -DTRANSCRIBE_USE_SYSTEM_BLAS=OFF -DTRANSCRIBE_VULKAN=OFF \
        -DTRANSCRIBE_CUDA=OFF -DTRANSCRIBE_HIP=OFF -DTRANSCRIBE_METAL=OFF -DTRANSCRIBE_BUILD_SHARED=ON \
    && cmake --build /native/build --target transcribe-cli -j"$(nproc)"
# Header pins match the native build's FetchContent revisions (cpp-httplib v0.51.0 with its
# graceful-close backport, nlohmann/json v3.11.3).
COPY cmake/PatchHttplibGracefulClose.cmake /tmp/
RUN mkdir -p /include/nlohmann \
    && curl --fail --location --retry 3 -o /include/httplib.h \
        https://raw.githubusercontent.com/yhirose/cpp-httplib/d66d9a95997d51a8ba9822a611d1267757741535/httplib.h \
    && curl --fail --location --retry 3 -o /include/nlohmann/json.hpp \
        https://github.com/nlohmann/json/releases/download/v3.11.3/json.hpp \
    && printf '%s  %s\n' \
        dfbaccb76432ed6d56ddd9983fd9d262b61ba6ba0958f6b00db35c802607bd35 /include/httplib.h \
        9bea4c8066ef4a1c206b2be5a36302f8926f7fdc6087af5d20b417d0cf103ea6 /include/nlohmann/json.hpp \
        | sha256sum -c - \
    && cmake -DHTTPLIB_SOURCE_DIR=/include -P /tmp/PatchHttplibGracefulClose.cmake
COPY juiced/runtime/futo_server.cpp /adapter/futo_server.cpp
# Only real files under their SONAME: the runtime-package importer refuses symlinks.
RUN mkdir -p /opt/juiced/bundled/futo/lib /opt/juiced/bundled/futo/licenses \
    && g++ -std=c++17 -O2 -pthread -I/native/include -I/native/examples/common -I/include \
        /adapter/futo_server.cpp -L/native/build/src -ltranscribe \
        -Wl,-rpath-link,/native/build/ggml/src -o /opt/juiced/bundled/futo/futo-server \
    && strip /opt/juiced/bundled/futo/futo-server \
    && find /native/build -type f -name '*.so*' | while read -r library; do \
        soname=$(objdump -p "$library" | awk '/SONAME/ { print $2 }'); \
        cp "$library" "/opt/juiced/bundled/futo/lib/${soname:-${library##*/}}"; \
    done \
    && cp /native/LICENSE /opt/juiced/bundled/futo/licenses/transcribe.txt \
    && cp /native/THIRD-PARTY-LICENSES.md /opt/juiced/bundled/futo/licenses/ \
    && cp /native/ggml/LICENSE /opt/juiced/bundled/futo/licenses/ggml.txt \
    && LD_LIBRARY_PATH=/opt/juiced/bundled/futo/lib /opt/juiced/bundled/futo/futo-server --version
COPY --chmod=0755 juiced/rewrite/container/bundle-spec.sh /usr/local/bin/bundle-spec
RUN jq -nc --arg revision "$FUTO_REVISION" --arg sha "$FUTO_ARCHIVE_SHA256" \
        --argjson bytes "$FUTO_ARCHIVE_BYTES" '{builder_id: "juiced-image-build", \
          source_revision: $revision, build_revision: ("sha256:" + $sha), \
          declared_licenses: ["MIT"], declared_sbom: null, \
          release: {engine: "futo-transcribe.cpp", backend: "cpu", gpu_target: null, \
            repository: "gitlab.futo.org/keyboard/transcribe.cpp", tag: $revision, \
            asset: "repository/archive.tar.gz", archive_sha256: $sha, archive_bytes: $bytes, \
            digest_source: "pinned-source-archive"}}' >/tmp/provenance.json \
    && jq -nc --arg architecture "$(uname -m)" '{operating_system: "linux", \
          architecture: $architecture, abi: "gnu", compute_paths: ["cpu"]}' >/tmp/target.json \
    && bundle-spec /opt/juiced/bundled/futo futo-server futo-transcribe-cpp \
        "$(cat /tmp/provenance.json)" "$(cat /tmp/target.json)" >/opt/juiced/bundled/futo.import.json

FROM ${RUNTIME_IMAGE} AS runtime
ARG DEBIAN_FRONTEND=noninteractive
COPY juiced/rewrite/container/backports.sources /etc/apt/sources.list.d/backports.sources
# Mesa comes from trixie-backports so RADV and ANV track recent GPUs;
# juiced-update-userspace repeats this at runtime. The NVIDIA Vulkan ICD that the
# container toolkit injects (libGLX_nvidia) fails to create an instance without glvnd
# libEGL and libXext. Lavapipe is removed so a CPU-only host never reports Vulkan.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl tini \
        libatomic1 libgomp1 libnuma1 libstdc++6 zlib1g \
        libdrm2 libdrm-amdgpu1 libelf1t64 \
        libvulkan1 vulkan-tools libegl1 libxext6 \
    && apt-get install -y --no-install-recommends -t trixie-backports mesa-vulkan-drivers \
    && rm -f /usr/share/vulkan/icd.d/lvp_icd*.json \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 juiced \
    && useradd --uid 10001 --gid 10001 --home-dir /data/home --no-create-home \
        --shell /usr/sbin/nologin juiced \
    && install -d -o 10001 -g 10001 -m 0700 /data

COPY --from=service /out/lemond /out/lemonade /usr/local/bin/
COPY --from=ui /src/juiced/rewrite/ui/dist/ /opt/juiced/ui/
COPY --from=futo /opt/juiced/bundled/ /opt/juiced/bundled/
COPY LICENSE /opt/juiced/licenses/juiced-Apache-2.0.txt
COPY LICENSES/ /opt/juiced/licenses/inherited/
COPY --chmod=0755 juiced/rewrite/container/entrypoint.sh /usr/local/bin/juiced-entrypoint
COPY --chmod=0755 juiced/rewrite/container/healthcheck.sh /usr/local/bin/juiced-healthcheck
COPY --chmod=0755 juiced/rewrite/container/update-userspace.sh /usr/local/bin/juiced-update-userspace

ARG SOURCE_REVISION=development
LABEL org.opencontainers.image.title="Juiced" \
      org.opencontainers.image.description="Local model appliance: Rust supervisor, web console, engines installed on demand" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"

ENV JUICED_DATA=/data \
    JUICED_LISTEN_HOST=0.0.0.0 \
    LEMONADE_HOST=127.0.0.1 \
    LEMONADE_PORT=13305 \
    HOME=/data/home \
    XDG_CACHE_HOME=/data/home/.cache

VOLUME ["/data"]
EXPOSE 13305 10300
USER 10001:10001
WORKDIR /data
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["/usr/local/bin/juiced-healthcheck"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/juiced-entrypoint"]
